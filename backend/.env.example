NODE_ENV=development
PORT=3000

# Use either DATABASE_URL or individual connection settings below.
# Default PostgreSQL superuser is "postgres" (not "postgre").
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/real_estate_crm
DB_HOST=localhost
DB_PORT=5432
DB_NAME=real_estate_crm
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD

CORS_ORIGIN=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

JWT_ACCESS_SECRET=change_this_to_a_secure_random_string_min_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30
